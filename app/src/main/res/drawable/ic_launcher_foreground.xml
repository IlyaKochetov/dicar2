<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon foreground: a gauge arc with a bottom gap and vehicle silhouette, echoing the twin dashboard.
  Artwork fits within the central 72dp safe zone of the 108dp canvas (radius 28 arc and centered car).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Both arcs share a circle centered at (54,54), radius 28, sweeping clockwise 240° from 150°.
      This matches ArcGauge START/SWEEP. Endpoints are calculated as (54+28cosθ, 54+28sinθ):
        θ=150°  → (29.751, 68.000)   start
        θ=318°  → (74.808, 35.264)   70%
        θ=390°  → (78.249, 68.000)   end
      Endpoints must lie on this circle. If the chord exceeds 2r, SVG enlarges the radius and moves
      the center to the chord midpoint, making the arcs non-concentric, as happened with (75.4,32.2).
    -->

    <!-- Gauge track arc (dim) -->
    <path
        android:pathData="M29.751,68 A28,28 0 1 1 78.249,68"
        android:strokeColor="#4D35C7F2"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Gauge progress arc (bright, reaching 70%) -->
    <path
        android:pathData="M29.751,68 A28,28 0 0 1 74.808,35.264"
        android:strokeColor="#FF35C7F2"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Vehicle silhouette -->
    <group
        android:scaleX="1.65"
        android:scaleY="1.65"
        android:translateX="34.2"
        android:translateY="37.2">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M18.92,6.01C18.72,5.42 18.16,5 17.5,5h-11c-0.66,0 -1.21,0.42 -1.42,1.01L3,12v8c0,0.55 0.45,1 1,1h1c0.55,0 1,-0.45 1,-1v-1h12v1c0,0.55 0.45,1 1,1h1c0.55,0 1,-0.45 1,-1v-8l-2.08,-5.99zM6.5,16c-0.83,0 -1.5,-0.67 -1.5,-1.5S5.67,13 6.5,13s1.5,0.67 1.5,1.5S7.33,16 6.5,16zM17.5,16c-0.83,0 -1.5,-0.67 -1.5,-1.5s0.67,-1.5 1.5,-1.5 1.5,0.67 1.5,1.5 -0.67,1.5 -1.5,1.5zM5,11l1.5,-4.5h11L19,11L5,11z" />
    </group>
</vector>
